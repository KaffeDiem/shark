#!/usr/bin/env python3
# Local PR fixtures for setup.sh's ios stack; never contact GitHub.
import json
import os
import subprocess
import sys

prs = json.loads(r'''[{"number":142,"title":"Run a sync on launch and from settings","author":{"login":"demo"},"headRefName":"eng-142-sync-wiring","baseRefName":"eng-141-sync-ui","url":"https://github.com/acme/ios/pull/142","state":"OPEN","isDraft":true,"updatedAt":"2026-10-24T09:12:00Z","isCrossRepository":false},
 {"number":141,"title":"Sync settings screen","author":{"login":"demo"},"headRefName":"eng-141-sync-ui","baseRefName":"eng-140-sync-logic","url":"https://github.com/acme/ios/pull/141","state":"OPEN","isDraft":false,"updatedAt":"2026-10-23T15:40:00Z","isCrossRepository":false},
 {"number":140,"title":"SyncEngine: pull changes since the last sync","author":{"login":"demo"},"headRefName":"eng-140-sync-logic","baseRefName":"main","url":"https://github.com/acme/ios/pull/140","state":"OPEN","isDraft":false,"updatedAt":"2026-10-22T11:05:00Z","isCrossRepository":false}]''')
args = sys.argv[1:]
if os.path.basename(os.getcwd()) != 'ios' or args[:2] != ['pr', 'list']:
    prs = []
elif '--head' in args:
    branch = args[args.index('--head') + 1]
    prs = [pr for pr in prs if pr['headRefName'] == branch]
    for pr in prs:
        pr.update(mergeStateStatus='CLEAN', reviewDecision='APPROVED', statusCheckRollup=[], reviews=[])
        pr['headRefOid'] = subprocess.check_output(
            ['git', 'rev-parse', branch], text=True).strip()
print(json.dumps(prs))
